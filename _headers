/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-cSNKjEBLz9LuROsZbpnUi/iPPZGI3OWSx/bWv1p7b00='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'none'; form-action https://formsubmit.co; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Les noms de fichiers ne portent pas d'empreinte : une image remplacee garde
# son nom. Un cache d'un jour accelere la visite sans figer une correction
# pendant un an.
/images/*
  Cache-Control: public, max-age=86400
/previews/*
  Cache-Control: public, max-age=86400
